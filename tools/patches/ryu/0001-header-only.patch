   // The first value this approximation fails for is 2^1651 which is just greater than 10^297.
-  assert(e >= 0);
-  assert(e <= 1650);
+  RYU_ASSERT(e >= 0);
+  RYU_ASSERT(e <= 1650);
   return (((uint32_t) e) * 78913) >> 18;
