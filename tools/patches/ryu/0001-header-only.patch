 // Returns floor(log_10(5^e)).
 static inline uint32_t log10Pow5(const int32_t e) {
   // The first value this approximation fails for is 5^2621 which is just greater than 10^1832.
-  assert(e >= 0);
-  assert(e <= 2620);
+  RYU_ASSERT(e >= 0);
+  RYU_ASSERT(e <= 2620);
   return (((uint32_t) e) * 732923) >> 20;
 }
 
