Add FFC_LINKAGE and FFC_LINKAGE_EXTERN, the linkage of every public
function, so that a header-only build can make them all static.

Defaults keep upstream behaviour: FFC_LINKAGE is empty and
FFC_LINKAGE_EXTERN is extern. zufast defines both as static
(inst/include/zufast/detail/vendor_config.h).

Upstream: to be submitted to kolemannix/ffc.h.

--- a/ffc.h
+++ b/ffc.h
@@ -113,6 +113,15 @@
 #ifndef FFC_API
 #define FFC_API
 
+/* The linkage of every public function. Empty by default, which gives
+ * external linkage; a header-only build defines both as `static`. */
+#ifndef FFC_LINKAGE
+#define FFC_LINKAGE
+#endif
+#ifndef FFC_LINKAGE_EXTERN
+#define FFC_LINKAGE_EXTERN extern
+#endif
+
 #define FFC_VERSION_YEAR  26
 #define FFC_VERSION_MONTH 09
 #define FFC_VERSION_BUILD 01
