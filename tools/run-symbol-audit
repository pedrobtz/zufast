#!/bin/sh
# Design 21.3: the compiled-code audit. Builds the call-everything probe
# (tools/abi/probe-all.c) into a shared object with R's own compiler and
# flags, at R's optimisation level and at -O0, and fails if it references any
# symbol R CMD check reports in compiled code. Because every zufast function
# is compiled into each consumer, a hit here would be a NOTE in every
# consumer's check, not in zufast's. It also fails if the probe object holds
# writable data (an nm d/D/b/B symbol) other than ffc's one deliberate
# volatile in ffc_rounds_to_nearest(): every table must be const, so that it
# is read-only and no consumer translation unit carries a writable copy
# (#23). Run from the package root.
set -eu

ROOT=$(pwd)
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

# What R CMD check's "checking compiled code" looks for (tools:::check_so_symbols):
# termination, the C stdio streams and printing, and the C library's RNG.
FORBIDDEN='abort|__assert_fail|__assert_rtn|_assert|exit|_exit|_Exit|quick_exit|printf|vprintf|puts|putchar|stdout|stderr|__stdoutp|__stderrp|_stdout|_stderr|rand|srand|random|srandom|rand_r|drand48|srand48'

cp tools/abi/probe-all.c "$TMP/probe.c"
fail=0
for level in default O0; do
    rm -f "$TMP"/*.o "$TMP"/*.so
    if [ "$level" = O0 ]; then
        printf 'CFLAGS = -O0 -g\n' > "$TMP/Makevars"
        export R_MAKEVARS_USER="$TMP/Makevars"
    else
        unset R_MAKEVARS_USER || true
    fi
    (cd "$TMP" && PKG_CPPFLAGS="-I$ROOT/inst/include" R CMD SHLIB -o probe.so probe.c >build.log 2>&1) || {
        cat "$TMP/build.log"; echo "FAIL: the probe did not build ($level)"; exit 1; }
    case "$(uname -s)" in
        Darwin) syms=$(nm -u "$TMP/probe.so" | sed 's/^_//') ;;
        *)      syms=$(nm -u "$TMP/probe.so" | awk '{print $NF}' | sed 's/@.*//') ;;
    esac
    # Writable data in the object: local assembler labels (ltmpN, L..., .L...)
    # are not symbols of the code; the static volatile `fmin` is ffc's
    # rounding-mode probe and must stay writable.
    wdata=$(nm "$TMP/probe.o" | awk '$2 ~ /^[dDbB]$/ { print $3 }' |
        grep -vE '^(ltmp[0-9]+|l_.*|L.*|\..*)$' |
        grep -vE '^_?(ffc_rounds_to_nearest\.)?fmin(\.[0-9]+)?$' || true)
    if [ -n "$wdata" ]; then
        echo "FAIL ($level): writable data in the probe object:"
        printf '    %s\n' $wdata
        fail=1
    fi
    hits=$(printf '%s\n' "$syms" | grep -xE "($FORBIDDEN)" || true)
    if [ -n "$hits" ]; then
        echo "FAIL ($level): the probe references:"
        printf '    %s\n' $hits
        fail=1
    else
        echo "ok ($level): $(printf '%s\n' "$syms" | grep -c . | tr -d ' ') undefined symbols, none forbidden"
    fi
done
[ "$fail" -eq 0 ] && echo "symbol audit passed" || { echo "symbol audit FAILED"; exit 1; }
