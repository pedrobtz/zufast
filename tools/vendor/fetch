#!/bin/sh
# Maintainer only (network): download every source in the manifest at its
# pinned commit, check each file against archive_sha256, install it into the
# vendor tree, apply its patches, and record the checksums.
#
#   tools/vendor/fetch [source ...]     default: every source
. "$(dirname "$0")/common.sh"

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

manifest_rows | while IFS= read -r row; do
    src=$(field "$row" 1)
    if [ "$#" -gt 0 ]; then
        case " $* " in *" $src "*) ;; *) continue ;; esac
    fi
    repo=$(field "$row" 2)
    commit=$(field "$row" 4)
    hashes=$(field "$row" 7)
    i=0
    split_list "$(field "$row" 6)" | while IFS= read -r pair; do
        i=$((i + 1))
        up=${pair%%:*}
        dest=${pair#*:}
        want=$(split_list "$hashes" | sed -n "${i}p")
        url="https://raw.githubusercontent.com/$repo/$commit/$up"
        echo "fetch $src: $url"
        curl -sSfL --retry 3 -o "$TMP/file" "$url"
        got=$(sha256 "$TMP/file")
        if [ "$got" != "$want" ]; then
            echo "checksum mismatch for $src $up: got $got, manifest has $want" >&2
            exit 1
        fi
        mkdir -p "$(dirname "$VENDOR/$dest")"
        cp "$TMP/file" "$VENDOR/$dest"
    done
    split_list "$(field "$row" 10)" | while IFS= read -r p; do
        echo "patch $src: $p"
        patch -s -p1 -d "$VENDOR" < "$PATCHES/$src/$p"
    done
done
record_checksums
echo "fetched; now run tools/vendor/verify"
