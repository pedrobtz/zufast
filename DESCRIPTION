Package: zufast
Title: Fast Portable C Primitives for Parsing and Formatting Data
Version: 0.1.0.9000
Authors@R: 
    c(person("Pedro", "Z", , "pedrobtz@gmail.com", role = c("aut", "cre")),
      person("Bjoern", "Hoehrmann", role = "cph",
             comment = "UTF-8 decoder state table in inst/include/zufast/utf8.h"),
      person("The fast_float authors", role = "cph",
             comment = "fast_float, ported to C as ffc.h"),
      person("Koleman", "Nix", role = "cph",
             comment = "ffc.h, the C port of fast_float"),
      person("Ulf", "Adams", role = "cph", comment = "Ryu"),
